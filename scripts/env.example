# Параметры локального запуска. Скопируйте в .env (он в .gitignore) и заполните.
# Переменные читаются scripts/dev-env.ps1 и подставляются в Spring.
# Файл не обязателен: в application.yml есть дефолты для локальной базы,
# и IDEA запускает приложение без настройки окружения.

# База данных
DB_URL=jdbc:postgresql://localhost:5432/korobki
DB_USER=korobki
DB_PASSWORD=задайте-пароль-роли-korobki

# Слушать не только петлевой интерфейс (по умолчанию 127.0.0.1).
# SERVER_ADDRESS=0.0.0.0
